# POSTGRES_* only configure the LOCAL dev/test db container (backend/docker-compose.yml).
# Production uses a hosted Postgres: see deploy/README.md. Dev-only defaults; change POSTGRES_PASSWORD for anything beyond local use.
# The db port is bound to 127.0.0.1 only. DATABASE_URL is required (no default in code).
# Prod (Supabase session pooler, recommended): postgresql+psycopg://postgres.<ref>:<url-encoded-pw>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# TLS is enforced when ENVIRONMENT=prod. Optional tuning: DB_POOL_SIZE=5 DB_MAX_OVERFLOW=5 DB_SEARCH_PATH=public,extensions
# DB_DISABLE_PREPARED_STATEMENTS=true only with the transaction pooler (port 6543).
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel
DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5440/sentinel
# Placeholders: confirm exact IDs against the Token Factory catalog (tool-calling Nemotron, embedding, vision)
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
LLM_MODEL=nvidia/Llama-3_3-Nemotron-Super-49B-v1_5
VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
TOKEN_FACTORY_API_KEY=
TAVILY_API_KEY=
AGENT_MODE=hybrid
# Embeddings (semantic memory). Qwen3-Embedding-8B is Token Factory's only public embedding model: multilingual
# (incl. Hindi), 4096-d native, Matryoshka-trained, so vectors are truncated to EMBED_DIM and re-normalised.
# Confirm the exact model ID with: curl -s -H "Authorization: Bearer $TOKEN_FACTORY_API_KEY" $TOKEN_FACTORY_BASE_URL/models
# SEMANTIC_THRESHOLD (0.25) was tuned for the LOCAL MiniLM model, NOT for Qwen3: re-tune it with
# `uv run python scripts/tune_semantic_threshold.py --yes` before relying on semantic links
# (set SEMANTIC_MEMORY=false until then if unsure).
EMBEDDING_PROVIDER=token_factory
EMBED_MODEL=Qwen/Qwen3-Embedding-8B
EMBED_DIM=1024
# send the OpenAI-compatible `dimensions` parameter (retried once without it if the server rejects it)
EMBED_SEND_DIMENSIONS=true
# Link inspector (../inspector). compose sets INSPECTOR_URL=http://inspector:8080 for the api.
# INSPECTOR_SECRET is shared by api and inspector; >= 16 chars (e.g. `openssl rand -hex 24`).
INSPECTOR_URL=
INSPECTOR_SECRET=
# Optional threat feeds used by the inspector. No SAFE_BROWSING_API_KEY: Safe Browsing skipped.
# URLhaus now REQUIRES an Auth-Key (free, https://auth.abuse.ch/); without it lookups fail and give no hits.
SAFE_BROWSING_API_KEY=
URLHAUS_AUTH_KEY=
# Family alerts (push to guardians). Path to a Firebase service-account JSON; empty -> no pushes are sent.
FIREBASE_CREDENTIALS_FILE=
# Secret mixed into stored pairing-code hashes; set a random value (e.g. `openssl rand -hex 24`).
# REQUIRED (>= 16 chars) when ENVIRONMENT=prod: the API refuses to start without it.
FAMILY_CODE_PEPPER=
# dev | test | prod. Outside dev/test a missing pepper is logged as an ERROR; in prod it is fatal.
ENVIRONMENT=dev
# Failed pairing-code attempts across ALL users per hour before every accept returns 429 (legit pairing
# pauses too while under a guessing attack; that is the intended trade-off).
FAMILY_GLOBAL_ACCEPT_FAILURES_PER_HOUR=300
# POST /v1/devices/register per client IP per hour.
REGISTER_PER_IP_PER_HOUR=20
# POST /v1/check per USER per hour: JSON text checks and multipart screenshot checks (vision model) are
# counted separately; beyond the limit -> 429 {"detail": "rate limit exceeded"}. JSON bodies are capped at 64 KB (413).
CHECK_RATE_LIMIT_PER_HOUR=30
CHECK_IMAGE_RATE_LIMIT_PER_HOUR=10
# Use X-Forwarded-For for the client IP. Only set true behind our reverse proxy (Caddy), which appends the
# real peer address. The client is taken TRUSTED_PROXY_COUNT entries from the RIGHT (1 = Caddy's entry);
# entries further left are client-controlled and ignored. Invalid values fall back to the socket peer.
# IPv4-mapped IPv6 counts as IPv4 and IPv6 clients are limited per /64.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_COUNT=1
# Demo web dashboard at /dashboard (+ GET /v1/dashboard/timeline, which returns only the CALLER's data, so
# open it with the demo user's token from `python -m sim.inject`). Default false -> 404. Never enable in prod
# unless you want a public page asking for a bearer token.
DEMO_ENABLED=false
# Dev-only CORS for the browser test console (../frontend). Comma-separated exact origins; default empty = no CORS
# middleware. '*' is rejected unless ENVIRONMENT=dev/test; in prod every origin must be https.
# CORS_ALLOW_ORIGINS=http://localhost:5173

# First-pass classifier gate. rules = off (default). laya = self-hosted Laya zero-shot (uv sync --extra laya);
# it can only ADD an agent escalation (scam_prob >= CLASSIFIER_THRESHOLD), never lower a tier. See docs/classifier.md:
# zero-shot Laya did NOT beat chance-level precision on our eval; keep rules unless you fine-tune.
CLASSIFIER=rules
CLASSIFIER_THRESHOLD=0.5
CLASSIFIER_TIMEOUT_MS=300
LAYA_MODEL=multilingual
# ---- Persistent memory + two-stage review (docs/memory.md). Safe defaults: with no key and no provider,
# semantic memory is OFF and stage 2 does not run (behaviour = single stage).
# EMBEDDING_PROVIDER: empty = auto (token_factory when TOKEN_FACTORY_API_KEY + EMBED_MODEL are set, else none)
# | token_factory | local (uv sync --extra semantic; downloads LOCAL_EMBED_MODEL, ~470 MB, Apache-2.0) | none.
# Only REDACTED text is embedded. EMBED_DIM is the pgvector column width: a shorter provider vector is
# zero-padded (exact for cosine); migration 0009 resizes the column only while it is empty.
# (EMBEDDING_PROVIDER is set in the embeddings block above)
# SEMANTIC_MEMORY=false forces semantic memory off (unset = on only when a provider is usable)
LOCAL_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_TIMEOUT_S=5
# cosine similarity needed to link two events (tuned on the eval TUNE split for the local model; re-tune for
# another model: RE-TUNE for Qwen3 with scripts/tune_semantic_threshold.py), max neighbours and look-back window
SEMANTIC_THRESHOLD=0.25
SEMANTIC_K=5
SEMANTIC_WINDOW_DAYS=14
# Rules-only scam-story progression signal across linked events (no LLM)
STORY_PROGRESSION=true
# Stage-2 agent: escalated (default: only events stage 2 newly escalates) | all (every event; costs LLM calls)
AGENT_REVIEW=escalated
AGENT_REVIEW_DAILY_CAP=200
REVIEW_WORKERS=2
REVIEW_QUEUE_SIZE=256
REVIEW_SWEEP_MINUTES=5
REVIEW_MAX_QUEUED_PER_USER=20
