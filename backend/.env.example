# Dev-only defaults; change POSTGRES_PASSWORD for anything beyond local use.
# The db port is bound to 127.0.0.1 only. DATABASE_URL is required (no default in code).
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel
DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5440/sentinel
# Placeholders: confirm exact IDs against the Token Factory catalog (tool-calling Nemotron, embedding, vision)
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
LLM_MODEL=nvidia/Llama-3_3-Nemotron-Super-49B-v1_5
EMBED_MODEL=BAAI/bge-en-icl
VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
TOKEN_FACTORY_API_KEY=
TAVILY_API_KEY=
AGENT_MODE=hybrid
EMBED_DIM=1024
# Link inspector (../inspector). compose sets INSPECTOR_URL=http://inspector:8080 for the api.
# INSPECTOR_SECRET is shared by api and inspector; >= 16 chars (e.g. `openssl rand -hex 24`).
INSPECTOR_URL=
INSPECTOR_SECRET=
# Optional threat feeds used by the inspector. No SAFE_BROWSING_API_KEY: Safe Browsing skipped.
# URLhaus now REQUIRES an Auth-Key (free, https://auth.abuse.ch/); without it lookups fail and give no hits.
SAFE_BROWSING_API_KEY=
URLHAUS_AUTH_KEY=
# Family alerts (push to guardians). Path to a Firebase service-account JSON; empty -> no pushes are sent.
FIREBASE_CREDENTIALS_FILE=
# Secret mixed into stored pairing-code hashes; set a random value (e.g. `openssl rand -hex 24`).
# REQUIRED (>= 16 chars) when ENVIRONMENT=prod: the API refuses to start without it.
FAMILY_CODE_PEPPER=
# dev | test | prod. Outside dev/test a missing pepper is logged as an ERROR; in prod it is fatal.
ENVIRONMENT=dev
# Failed pairing-code attempts across ALL users per hour before every accept returns 429 (legit pairing
# pauses too while under a guessing attack; that is the intended trade-off).
FAMILY_GLOBAL_ACCEPT_FAILURES_PER_HOUR=300
# POST /v1/devices/register per client IP per hour.
REGISTER_PER_IP_PER_HOUR=20
# Use X-Forwarded-For for the client IP. Only set true behind our reverse proxy (Caddy), which appends the
# real peer address. The client is taken TRUSTED_PROXY_COUNT entries from the RIGHT (1 = Caddy's entry);
# entries further left are client-controlled and ignored. Invalid values fall back to the socket peer.
# IPv4-mapped IPv6 counts as IPv4 and IPv6 clients are limited per /64.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_COUNT=1
