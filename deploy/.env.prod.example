# Copy to deploy/.env.prod (gitignored) and fill in. Generate secrets with: openssl rand -hex 24
SITE_ADDRESS=sentinel.example.com            # public DNS name pointing at this VM (ports 80/443 open)

# REQUIRED. Supabase Postgres (pgvector enabled): use the SESSION POOLER string (IPv4, port 5432, user postgres.<ref>).
# Use TLS: sslmode=require, or sslmode=verify-full&sslrootcert=/path/ca.pem with Supabase's CA
# (the api refuses to start in prod without sslmode on a remote host). Never commit real credentials.
DATABASE_URL=postgresql+psycopg://postgres.PROJECTREF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Only with the transaction pooler (port 6543): DB_DISABLE_PREPARED_STATEMENTS=true

FAMILY_CODE_PEPPER=                          # REQUIRED, >= 16 chars; rotating it invalidates pending invites
INSPECTOR_SECRET=                            # REQUIRED, >= 16 chars; shared by api and inspector

# Token Factory (Nebius). Placeholders: confirm model IDs against the catalog.
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
TOKEN_FACTORY_API_KEY=
LLM_MODEL=nvidia/Llama-3_3-Nemotron-Super-49B-v1_5
EMBED_MODEL=BAAI/bge-en-icl
VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
EMBED_DIM=1024
AGENT_MODE=hybrid
TAVILY_API_KEY=

# Optional threat feeds for the inspector
SAFE_BROWSING_API_KEY=
URLHAUS_AUTH_KEY=

# Optional push (mount the JSON, see docker-compose.prod.yml)
FIREBASE_CREDENTIALS_FILE=

# Demo dashboard at /dashboard: leave false unless you are demoing, then switch back.
DEMO_ENABLED=false
REGISTER_PER_IP_PER_HOUR=20
# ENVIRONMENT, TRUST_PROXY_HEADERS, TRUSTED_PROXY_COUNT, and INSPECTOR_URL are set by the compose file.
